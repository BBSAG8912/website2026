---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import { company, routes } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Footer nur mit Schlusszeile */
  compactFooter?: boolean;
  /** Footer direkt an den Inhalt (Startseite) */
  footerSpace?: 'tight' | 'section';
  /** Ziel der Haupt-CTA in Header und CTA-Leiste */
  ctaHref?: string;
  ctaLabel?: string;
  noindex?: boolean;
}

const {
  title,
  description = `${company.name} – ${company.claim}. Service, Entkalkung, Reparatur und Ersatz von Boilern, Solar sowie Korrosions- und Kalkschutz. ${company.subClaim}.`,
  compactFooter = false,
  footerSpace = 'section',
  ctaHref = routes.formService,
  ctaLabel = 'Service anfragen',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${company.name}` : `${company.name} – ${company.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#6A5497" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <div class="page">
      <Header ctaHref={ctaHref} ctaLabel={ctaLabel} />
      <main id="inhalt" tabindex="-1">
        <slot />
      </main>
      <Footer compact={compactFooter} spaceTop={footerSpace} />
      <MobileCtaBar ctaHref={ctaHref} ctaLabel={ctaLabel} />
    </div>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
