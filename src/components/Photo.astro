---
/**
 * Vollflächiges Foto (object-fit: cover) – oder, solange der Kunde noch kein
 * Bild geliefert hat, der schraffierte Platzhalter mit «FOTO: …»-Beschreibung.
 * Das Elternelement muss position: relative haben.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Beschreibung, welches Bild hierhin gehört (für den Platzhalter) */
  hint?: string;
  /** Bildbreiten für srcset */
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  image,
  alt = '',
  hint,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 900px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;
---

<div class="photo" aria-hidden={image ? undefined : 'true'}>
  {
    image ? (
      <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} class="photo__img" />
    ) : (
      hint && <span class="photo__tag">FOTO: {hint}</span>
    )
  }
</div>

<style>
  .photo {
    position: absolute;
    inset: 0;
    background: var(--photo-placeholder);
    overflow: hidden;
  }

  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__tag {
    position: absolute;
    top: 16px;
    right: 16px;
    max-width: min(260px, calc(100% - 32px));
    font: 500 12px/1.4 var(--font-mono);
    color: var(--c-on-dark-muted);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    padding: 6px 8px;
    text-align: right;
  }

  @media (max-width: 899.98px) {
    .photo__tag {
      top: 14px;
      right: 14px;
      font-size: 11px;
      border-radius: 5px;
      padding: 4px 6px;
    }
  }
</style>
