---
/** Einstieg der Themenseite (6b): links Kachel mit Pfad/Titel/Text/Buttons, rechts Foto. */
import type { ImageMetadata } from 'astro';
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';
import Button from './Button.astro';
import Copy from './Copy.astro';
import Photo from './Photo.astro';
import { company } from '../data/site';

interface Props {
  crumbs: Crumb[];
  /** Kürzerer Pfad für mobil (ohne «Startseite») */
  title: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageHint?: string;
}

const { crumbs, title, intro, ctaLabel, ctaHref, image, imageAlt, imageHint } = Astro.props;
---

<section class="topic-hero">
  <div class="topic-hero__text">
    <Breadcrumb items={crumbs} />
    <h1 class="topic-hero__title" lang="de">{title}</h1>
    <p class="topic-hero__intro"><Copy text={intro} /></p>
    <div class="topic-hero__actions">
      <Button href={ctaHref} variant="primary" size="lg" blockOnMobile>{ctaLabel}</Button>
      <Button href={company.phone.href} variant="white" size="lg" class="topic-hero__phone">{company.phone.display}</Button>
    </div>
  </div>
  <div class="topic-hero__photo">
    <Photo image={image} alt={imageAlt} hint={imageHint} loading="eager" sizes="(min-width: 900px) 50vw, 100vw" />
  </div>
</section>

<style>
  .topic-hero {
    padding: 8px var(--gutter-tiles) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap-tiles);
  }

  .topic-hero__text {
    min-height: 520px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: var(--r-tile);
    background: var(--c-surface-tint);
  }

  .topic-hero__title {
    margin-top: auto;
    font-size: clamp(48px, 5.3vw, 68px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.035em;
    hyphens: auto;
  }

  .topic-hero__intro {
    font-size: 18px;
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  .topic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-hero__actions :global(.btn) {
    padding: 14.5px 23.5px;
  }

  .topic-hero__photo {
    position: relative;
    min-height: 520px;
    border-radius: var(--r-tile);
    overflow: hidden;
  }

  @media (max-width: 899.98px) {
    .topic-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .topic-hero__text {
      min-height: 0;
      padding: 24px;
      gap: 16px;
    }

    .topic-hero__title {
      margin-top: 0;
      font-size: 38px;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .topic-hero__intro {
      font-size: 16px;
    }

    .topic-hero__actions :global(.topic-hero__phone) {
      display: none;
    }

    .topic-hero__photo {
      min-height: 240px;
    }
  }
</style>
