---
/**
 * FAQ-Akkordeon «Häufige Fragen» – natives <details>/<summary> (barrierefrei, ohne JS).
 * Mit `name` öffnet sich jeweils nur eine Frage (moderne Browser).
 */
import Copy from './Copy.astro';

interface Props {
  title?: string;
  items: { q: string; a: string }[];
}

const { title = 'Häufige Fragen', items } = Astro.props;
const group = `faq-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="faq">
  <h2 class="faq__title">{title}</h2>
  <div class="faq__list">
    {
      items.map((it) => (
        <details class="faq__item" name={group}>
          <summary class="faq__q">
            <span>
              <Copy text={it.q} />
            </span>
            <span class="faq__sign" aria-hidden="true" />
          </summary>
          <p class="faq__a">
            <Copy text={it.a} />
          </p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 48px;
    padding: var(--section-space) var(--gutter-text) 0;
  }

  .faq__title {
    font-size: 40px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq__item {
    border-radius: var(--r-item);
    background: var(--c-surface-tint);
    transition: background-color 0.25s;
  }

  .faq__item[open] {
    background: var(--c-surface-tint-hover);
  }

  .faq__q {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline-offset: -2px;
    border-radius: var(--r-item);
  }

  .faq__sign {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    color: var(--c-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq__sign::before {
    content: '+';
  }

  .faq__item[open] .faq__sign::before {
    content: '–';
  }

  .faq__a {
    padding: 0 24px 22px;
    margin-top: -10px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  @media (max-width: 899.98px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: var(--section-space) 10px 0;
    }

    .faq__title {
      padding-inline: 10px;
      font-size: 28px;
      line-height: 1.1;
    }

    .faq__q {
      padding: 18px 20px;
      gap: 12px;
      font-size: 16px;
    }

    .faq__a {
      padding: 0 20px 18px;
      margin-top: -8px;
      font-size: 15px;
      line-height: 1.5;
    }
  }
</style>
