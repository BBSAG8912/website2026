---
/** Kernaussage links (gross) + Einleitung rechts (6c, 6k). */
import Copy from './Copy.astro';

interface Props {
  statement: string;
  intro: string;
}

const { statement, intro } = Astro.props;
---

<section class="lead-split">
  <h2 class="lead-split__statement"><Copy text={statement} /></h2>
  <p class="lead-split__intro"><Copy text={intro} /></p>
</section>

<style>
  .lead-split {
    padding: 72px var(--gutter-text) 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .lead-split__statement {
    font-size: 40px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .lead-split__intro {
    font-size: 19px;
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  @media (max-width: 899.98px) {
    .lead-split {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding: 36px 20px 28px;
    }

    .lead-split__statement {
      font-size: 26px;
      line-height: 1.15;
      letter-spacing: -0.015em;
    }

    .lead-split__intro {
      font-size: 16px;
    }
  }
</style>
