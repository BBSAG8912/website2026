---
/**
 * Themenseite (Vorlage 6b): Einstieg · So läuft es ab · 3 Textkacheln · Häufige Fragen ·
 * weitere Themen derselben Rubrik.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicHero from './TopicHero.astro';
import SectionTitle from './SectionTitle.astro';
import StepTile from './StepTile.astro';
import TextTile from './TextTile.astro';
import Faq from './Faq.astro';
import PhotoColumns from './PhotoColumns.astro';
import HeatPumpBoiler from './HeatPumpBoiler.astro';
import Photo from './Photo.astro';
import { type Topic, sections, topicHref, topicsOf } from '../data/topics';
import { routes } from '../data/site';

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const section = sections[topic.section];
const siblings = topicsOf(topic.section).filter((t) => t.slug !== topic.slug);
---

<BaseLayout title={topic.title} description={`${topic.title} – ${section.title}. Berger Boiler-Service AG, Ihr Warmwasserspezialist seit 1992.`}>
  <TopicHero
    crumbs={[{ label: 'Startseite', href: routes.home }, { label: section.title, href: section.href }, { label: topic.title }]}
    title={topic.title}
    intro={topic.intro}
    ctaLabel={section.ctaLabel}
    ctaHref={section.ctaHref}
    image={topic.image}
    imageAlt={topic.imageAlt}
    imageHint={topic.imageHint}
  />

  <SectionTitle title="So läuft es ab" />
  <div class="tile-grid">
    {topic.steps.map((s, i) => <StepTile n={i + 1} title={s.title} text={s.text} />)}
  </div>
  <div class="tile-grid">
    {topic.blocks.map((b) => <TextTile title={b.title} text={b.text} />)}
  </div>

  {
    topic.feature && (
      <section class="feature" aria-labelledby="feature-title">
        <div class="feature__text">
          <h2 id="feature-title">{topic.feature.title}</h2>
          <p>{topic.feature.text}</p>
          <ul>
            {topic.feature.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
        {topic.feature.image ? (
          <div class="feature__photo">
            <Photo image={topic.feature.image} alt={topic.feature.imageAlt} sizes="(min-width: 900px) 45vw, 100vw" />
          </div>
        ) : (
          topic.feature.illustration === 'waermepumpenboiler' && <HeatPumpBoiler />
        )}
      </section>
    )
  }

  <Faq items={topic.faqs} />

  <SectionTitle title={section.siblingsTitle} />
  <div class="pad-tiles">
    <PhotoColumns
      height={380}
      titleSize={36}
      mobileHeight={130}
      items={siblings.map((s) => ({
        n: '',
        title: s.title,
        text: s.teaser,
        image: s.relatedImage ?? s.tileImage ?? s.image,
        imageAlt: s.imageAlt,
        imageHint: s.imageHint,
        cta: { label: 'Zum Thema', href: topicHref(s) },
      }))}
    />
  </div>
</BaseLayout>

<style>
  .feature {
    margin: var(--gap-tiles) var(--gutter-tiles) 0;
    padding: var(--gap-tiles);
    border-radius: var(--r-tile);
    background: var(--c-surface-tint);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap-tiles);
  }

  .feature__text {
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .feature__text h2 {
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .feature__text p {
    font-size: 18px;
    line-height: 1.55;
  }

  .feature__text ul {
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  .feature__photo {
    position: relative;
    min-height: 560px;
    border-radius: calc(var(--r-tile) - 8px);
    overflow: hidden;
  }

  @media (max-width: 899.98px) {
    .feature__photo {
      min-height: 420px;
    }

    .feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature__text {
      padding: 20px 12px;
    }

    .feature__text h2 {
      font-size: 30px;
    }

    .feature__text p {
      font-size: 17px;
    }
  }
</style>
