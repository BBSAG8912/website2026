---
/** Projekte / Referenzen: 4 Bildkacheln (4:5); mobil horizontal scrollbar. */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Copy from './Copy.astro';

export interface Project {
  title: string;
  meta: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  items: Project[];
  label?: string;
}

const { items, label = 'Projekte' } = Astro.props;
---

<div class="projects-scroll">
  <ul class="projects" aria-label={label}>
    {
      items.map((p) => (
        <li class="project">
          <Photo image={p.image} alt={p.imageAlt} sizes="(min-width: 900px) 25vw, 240px" />
          <div class="project__body">
            <span class="project__title">
              <Copy text={p.title} onDark />
            </span>
            <span class="project__meta">
              <Copy text={p.meta} onDark />
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter-tiles);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-tiles);
  }

  .project {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-tile);
    overflow: hidden;
  }

  .project__body {
    position: absolute;
    inset: auto 0 0 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(to top, rgba(24, 19, 34, 0.85), rgba(24, 19, 34, 0));
  }

  .project__title {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }

  .project__meta {
    font-size: 14px;
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 899.98px) {
    .projects-scroll {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .projects-scroll::-webkit-scrollbar {
      display: none;
    }

    .projects {
      display: flex;
      width: max-content;
    }

    .project {
      width: 240px;
      height: 300px;
      aspect-ratio: auto;
      scroll-snap-align: start;
      scroll-margin-left: 10px;
    }

    .project__body {
      padding: 16px;
      gap: 2px;
    }

    .project__title {
      font-size: 16px;
    }

    .project__meta {
      font-size: 13px;
    }
  }
</style>
