---
/**
 * Angebotsseite mit Vollbild-Foto (6c Solar, 6k Korrosions- und Kalkschutz):
 * Foto + Titel · Kernaussage/Einleitung · 3 Textkacheln · Projekte · Warum wir · violetter CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHero from './PhotoHero.astro';
import LeadSplit from './LeadSplit.astro';
import TextTile from './TextTile.astro';
import SectionTitle from './SectionTitle.astro';
import ProjectTiles, { type Project } from './ProjectTiles.astro';
import StepTile from './StepTile.astro';
import CtaBlock from './CtaBlock.astro';
import { whyUs, placeholderProjects } from '../data/topics';
import { routes } from '../data/site';

interface Props {
  title: string;
  description: string;
  heroHint: string;
  titleSize: number;
  mobileTitleSize: number;
  ctaLabel: string;
  ctaHref: string;
  statement: string;
  ctaTitle: string;
  intro?: string;
  blocks?: { title: string; text: string }[];
  projects?: Project[];
}

const placeholderBlocks = [1, 2, 3].map((n) => ({ title: `[Abschnitt ${n}]`, text: '[2–3 Sätze]' }));

const {
  title,
  description,
  heroHint,
  titleSize,
  mobileTitleSize,
  ctaLabel,
  ctaHref,
  statement,
  ctaTitle,
  intro = '[Einleitung: Angebot, für wen, Nutzen]',
  blocks = placeholderBlocks,
  projects = placeholderProjects,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PhotoHero
    crumbs={[{ label: 'Startseite', href: routes.home }, { label: title }]}
    title={title}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    titleSize={titleSize}
    mobileTitleSize={mobileTitleSize}
    imageHint={heroHint}
  />

  <LeadSplit statement={statement} intro={intro} />

  <div class="tile-grid">
    {blocks.map((b) => <TextTile title={b.title} text={b.text} />)}
  </div>

  <SectionTitle title="Projekte und Referenzen" />
  <ProjectTiles items={projects} label="Projekte und Referenzen" />

  <SectionTitle title="Warum Sie bei uns richtig sind" />
  <div class="tile-grid tile-grid--m2" style="--cols: 4">
    {whyUs.map((w, i) => <StepTile tone="soft" n={i + 1} title={w.title} text={w.text} />)}
  </div>

  <CtaBlock title={ctaTitle} ctaLabel={ctaLabel} ctaHref={ctaHref} />
</BaseLayout>
