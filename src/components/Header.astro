---
/**
 * Kopfzeile (DsHeader / DsMHeader).
 * Bewusst ohne Menü (Kundenentscheid) – Navigation über Startseiten-Kacheln, Footer und Logo.
 * Mobil: sticky, nur Logo + Claim; Telefon/Service liegen in der MobileCtaBar.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-berger.png';
import Button from './Button.astro';
import { company, routes } from '../data/site';

interface Props {
  /** Ziel des Buttons rechts (Standard: Service anfragen) */
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = routes.formService, ctaLabel = 'Service anfragen' } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<header class="header">
  <a href={routes.home} class="header__logo" aria-label={isHome ? `${company.name} – Startseite` : 'Zur Startseite'}>
    <Image src={logo} alt="Berger Boiler-Service" widths={[208, 400]} sizes="(min-width: 900px) 200px, 130px" loading="eager" />
  </a>

  <div class="header__claim">
    <span class="header__title">{company.claim}</span>
    <span class="header__sub">{company.subClaim}</span>
  </div>

  <div class="header__actions">
    <Button href={company.phone.href} variant="outline" size="md">{company.phone.display}</Button>
    <Button href={ctaHref} variant="primary" size="lg">{ctaLabel}</Button>
  </div>
</header>

<style>
  .header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    background: #fff;
  }

  .header__logo {
    justify-self: start;
    display: block;
  }

  .header__logo :global(img) {
    height: 80px;
    width: auto;
  }

  .header__claim {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .header__title {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .header__sub {
    font-size: 16px;
    font-weight: 500;
    color: var(--c-primary);
  }

  .header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Zwischengrössen: Claim etwas kleiner, damit alles auf eine Zeile passt */
  @media (max-width: 1180px) and (min-width: 900px) {
    .header__title {
      font-size: 21px;
    }
    .header__sub {
      font-size: 15px;
    }
    .header__logo :global(img) {
      height: 64px;
    }
  }

  @media (max-width: 899.98px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      justify-content: space-between;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.96);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .header__logo :global(img) {
      height: 52px;
    }

    .header__claim {
      align-items: flex-end;
      text-align: right;
      gap: 2px;
      max-width: 210px;
    }

    .header__title {
      font-size: 15px;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .header__sub {
      font-size: 13px;
    }

    .header__actions {
      display: none;
    }
  }
</style>
