---
/** Violetter CTA-Block (z. B. «Interesse an Solar?»): Titel + Telefon + Hauptaktion. */
import Button from './Button.astro';
import Copy from './Copy.astro';
import { company } from '../data/site';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  showPhone?: boolean;
}

const { title, ctaLabel, ctaHref, showPhone = true } = Astro.props;
---

<section class="cta-block">
  <h2 class="cta-block__title"><Copy text={title} onDark /></h2>
  <div class="cta-block__actions">
    {
      showPhone && (
        <Button href={company.phone.href} variant="outline-light" size="lg" class="cta-block__phone">
          {company.phone.display}
        </Button>
      )
    }
    <Button href={ctaHref} variant="white" size="lg" arrow blockOnMobile>
      {ctaLabel}
    </Button>
  </div>
</section>

<style>
  .cta-block {
    margin: var(--gap-tiles) var(--gutter-tiles) 0;
    padding: 48px;
    border-radius: var(--r-tile);
    background: var(--c-primary);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }

  .cta-block__title {
    font-size: 44px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .cta-block__actions {
    display: flex;
    gap: 8px;
    flex: none;
  }

  @media (max-width: 899.98px) {
    .cta-block {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 28px 24px;
    }

    .cta-block__title {
      font-size: 28px;
      line-height: 1.1;
      letter-spacing: -0.015em;
    }

    /* Telefon liegt mobil bereits in der CTA-Leiste */
    .cta-block__actions :global(.cta-block__phone) {
      display: none;
    }
  }
</style>
