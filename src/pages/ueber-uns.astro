---
/** 6e Über uns: Titel + Lead · Teamfoto · Geschichte / Werte · Team · Standorte · Footer compact. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import TextTile from '../components/TextTile.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Locations from '../components/Locations.astro';
import Copy from '../components/Copy.astro';
import { routes } from '../data/site';

/** Team: Einträge ergänzen, sobald Namen/Funktionen/Porträts vorliegen. */
const team: { name: string; role: string }[] = Array.from({ length: 8 }, () => ({ name: '[Name]', role: '[Funktion]' }));
---

<BaseLayout title="Über uns" description="Berger Boiler-Service AG – Ihr Warmwasserspezialist seit 1992, Elysator Servicestelle mit Standorten in Obfelden und Bubikon." compactFooter>
  <PageIntro crumbs={[{ label: 'Startseite', href: routes.home }, { label: 'Über uns' }]} title="Über uns" layout="stacked">
    <p class="lead"><Copy text="[1–2 Sätze: wer wir sind]" /></p>
  </PageIntro>

  <div class="team-photo">
    <Photo hint="Team vor Firmengebäude / Fahrzeugen" loading="eager" sizes="100vw" widths={[800, 1200, 1600, 2400]} />
  </div>

  <div class="tile-grid" style="--cols: 2; padding-top: var(--gap-tiles)">
    <TextTile size="lg" title="Geschichte" text="[Text]" />
    <TextTile size="lg" title="Werte und Arbeitsweise" text="[Text]" />
  </div>

  <SectionTitle title="Team" />
  <ul class="team">
    {
      team.map((p) => (
        <li class="person">
          <div class="person__photo">
            <span>FOTO: Porträt</span>
          </div>
          <div class="person__text">
            <span class="person__name">
              <Copy text={p.name} />
            </span>
            <span class="person__role">
              <Copy text={p.role} />
            </span>
          </div>
        </li>
      ))
    }
  </ul>

  <SectionTitle title="Standorte" />
  <Locations />
</BaseLayout>

<style>
  .lead {
    max-width: 880px;
    font-size: 30px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--c-ink);
  }

  .team-photo {
    position: relative;
    margin: 0 var(--gutter-tiles);
    height: 520px;
    border-radius: var(--r-tile);
    overflow: hidden;
  }

  .team {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter-tiles);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px var(--gap-tiles);
  }

  .person {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .person__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-tile);
    background: var(--c-surface-tint);
    display: flex;
    align-items: flex-end;
    padding: 14px;
    font: 500 12px var(--font-mono);
    color: #6b6478;
  }

  .person__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 4px;
  }

  .person__name {
    font-size: 18px;
    font-weight: 600;
  }

  .person__role {
    font-size: 15px;
    color: var(--c-text-muted);
  }

  @media (max-width: 899.98px) {
    .lead {
      font-size: 20px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    .team-photo {
      height: 260px;
    }

    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 8px;
    }

    .person {
      gap: 8px;
    }

    .person__name {
      font-size: 16px;
    }

    .person__role {
      font-size: 14px;
    }
  }
</style>
