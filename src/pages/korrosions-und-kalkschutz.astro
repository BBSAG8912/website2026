---
/** 6k Korrosions- und Kalkschutz – Aufbau wie Solar, CTA führt zu «Service anfragen». */
import OfferPage from '../components/OfferPage.astro';
import { routes } from '../data/site';
---

<OfferPage
  title="Korrosions- und Kalkschutz"
  description="Korrosions- und Kalkschutz für Boiler und Wasserleitungen – Elysator Servicestelle Berger Boiler-Service AG."
  heroHint="Schutzanlage an Wasserleitung"
  titleSize={84}
  mobileTitleSize={42}
  ctaLabel="Service anfragen"
  ctaHref={routes.formService}
  statement="Wir betrachten nicht nur den Boiler, sondern das ganze Wasserverteilsystem."
  intro="Quell-, Grund- und Seewasser enthält oft viel Sauerstoff und Kohlensäure. Das führt in Boilern zunehmend zu Korrosion. Wir beraten Sie umfassend zu Kalk- und Korrosionsschutz."
  blocks={[
    {
      title: 'Erste Anzeichen erkennen',
      text: 'Hartnäckige Kalkablagerungen im Haushalt oder gelegentlich rotes Wasser aus dem Hahn deuten auf Kalk- oder Korrosionsprobleme hin. Bei emaillierten Boilern entstehen zudem feine Haarrisse, die korrodieren können.',
    },
    {
      title: 'Magnesium-Schutzanode',
      text: 'Die Anode im Behälter zieht die korrosive Wirkung des Wassers auf sich und wird dabei langsam verbraucht – der Boiler bleibt geschützt. Geeignet für emaillierte, plastifizierte, zementierte, Chromstahl- und schwarze Stahlboiler.',
    },
    {
      title: 'Elysator Servicestelle',
      text: 'Als technischer Kundendienst für Elysator verkaufen und betreuen wir Elysator-Anlagen – in Obfelden und Bubikon.',
    },
  ]}
  ctaTitle="Fragen zu Kalk oder Korrosion?"
/>
